# Copie para .env e troque os valores: cp .env.example .env
# Use senhas sem aspas, espaços ou caracteres especiais de shell ($ ` " ' \).

# Senha do root do MySQL (uso administrativo, dentro do container)
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# Usuário só-leitura que o Superset usa para ler a base leonardobonetti
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=troque_esta_senha_superset

# Chave secreta do Superset. Gere com: openssl rand -base64 42
SUPERSET_SECRET_KEY=troque_esta_chave

# Usuario administrador do Superset (criado automaticamente na subida)
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=troque_esta_senha_admin
